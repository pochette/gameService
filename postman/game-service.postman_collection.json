              "pm.test('JSON error', () => { const b = pm.response.json(); pm.expect(b.code).to.be.a('string'); pm.expect(b.message).to.be.a('string'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/users/{{userId}}/state",
        "body": {
          "mode": "raw",
          "raw": "{\"money\":100,",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "27 State exceeds 10240 bytes",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set('oversizedState', JSON.stringify({money:100,country:pm.collectionVariables.get('country'),payload:'x'.repeat(10240)}));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 413', () => pm.response.to.have.status(413));",
              "pm.test('JSON error', () => { const b = pm.response.json(); pm.expect(b.code).to.be.a('string'); pm.expect(b.message).to.be.a('string'); pm.expect(b.code).to.eql('STATE_TOO_LARGE'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/users/{{userId}}/state",
        "body": {
          "mode": "raw",
          "raw": "{{oversizedState}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "28 Verify invalid requests changed nothing",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Full replacement preserved', () => { const b=pm.response.json(); pm.expect(b.userId).to.eql(pm.collectionVariables.get('userId')); pm.expect(b.state).to.deep.eql({money:4500,country:pm.collectionVariables.get('country'),level:18,quest:{name:'first-race',completed:true}}); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/users/{{userId}}/state"
      }
    }
  ]
