          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Two separate events ordered by time', () => { const b=pm.response.json(); pm.expect(b).to.have.lengthOf(2); pm.expect(b.map(x=>x.activity).sort((a,c)=>a-c)).to.deep.eql([42,100]); b.forEach(x=>{ pm.expect(x.userId).to.eql(pm.collectionVariables.get('userId')); pm.expect(Date.parse(x.receivedAt)).to.be.at.least(Date.parse(pm.collectionVariables.get('from'))); pm.expect(Date.parse(x.receivedAt)).to.be.below(Date.parse(pm.collectionVariables.get('to'))); }); pm.expect(Date.parse(b[0].receivedAt)).to.be.at.most(Date.parse(b[1].receivedAt)); });"
            ]
          }
        }
      ],
