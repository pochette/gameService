{
  "info": {
    "name": "Game Service - Endpoint Checks",
    "description": "Run the entire collection in order with Collection Runner. Request 01 creates fresh UUIDs, a unique alphabetic country and a UTC period around the current time. Tests match the current API: wrapped user state and new-user count wrapped as {count}. Test users remain in the database. No authentication is configured.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "secondUserId",
      "value": "",
      "type": "string"
    },
    {
      "key": "unknownUserId",
      "value": "",
      "type": "string"
    },
    {
      "key": "country",
      "value": "",
      "type": "string"
    },
    {
      "key": "from",
      "value": "",
      "type": "string"
    },
    {
      "key": "to",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 Create first user (initialize variables)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const v = pm.collectionVariables;",
              "['userId','secondUserId','unknownUserId'].forEach(k => v.set(k, pm.variables.replaceIn('{{$guid}}')));",
              "v.set('country', 'TEST' + pm.variables.replaceIn('{{$guid}}').replace(/-/g, '').replace(/[0-9]/g, c => String.fromCharCode(65 + Number(c))).toUpperCase());",
              "v.set('from', new Date(Date.now() - 86400000).toISOString());",
              "v.set('to', new Date(Date.now() + 86400000).toISOString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Successful response', () => pm.expect(pm.response.code).to.be.within(200, 299));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/users/{{userId}}/state",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"money\": 1500,\n  \"country\": \"{{country}}\",\n  \"level\": 17,\n  \"inventory\": {\n    \"sword\": 2,\n    \"potion\": 5\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "02 Read original state",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Original state and unknown fields preserved', () => { const b=pm.response.json(); pm.expect(b.userId).to.eql(pm.collectionVariables.get('userId')); pm.expect(b.state).to.deep.eql({money:1500,country:pm.collectionVariables.get('country'),level:17,inventory:{sword:2,potion:5}}); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/users/{{userId}}/state"
      }
    },
